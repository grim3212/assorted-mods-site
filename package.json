{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .vue,.ts .",
    "deploy": "nuxt generate && npm run deploy:assets && npm run deploy:rest",
    "deploy:assets": "aws s3 sync .output/public/_nuxt s3://www.assortedmods.com/_nuxt --delete --cache-control \"public,max-age=31536000,immutable\"",
    "deploy:rest": "aws s3 sync .output/public s3://www.assortedmods.com --delete --exclude \"_nuxt/*\" --cache-control \"public,max-age=300\""
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@nuxtjs/robots": "^5.4.0",
    "@nuxtjs/sitemap": "^7.4.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^20.19.43",
    "eslint": "^8.57.1",
    "nuxt": "^3.21.11",
    "nuxt-link-checker": "^4.3.1",
    "typescript": "^5.9.3"
  }
}
